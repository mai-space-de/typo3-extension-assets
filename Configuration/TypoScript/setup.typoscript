# Provides {isCritical}, {loadingStrategy}, {fetchPriority}, {decodingStrategy} and
# {cssStrategy} to every content element template (fluid_styled_content and all
# elements based on lib.contentElement). stdWrap has no dataProcessing property.
lib.contentElement.dataProcessing.1763 = Maispace\MaiAssets\DataProcessing\CriticalAssetDataProcessor

plugin.tx_maispace_assets {
    settings {
        # HTML output minification (opt-in, disabled by default)
        htmlMinification {
            enable = 0
            stripComments = 1
            preserveTags = pre,code,textarea
        }
    }
}
