{
    "name": "maispace/mai-assets",
    "description": "Intelligent asset pipeline for TYPO3 with critical CSS, SVG sprites, responsive images, font preloading, and self-optimising above-fold detection.",
    "type": "typo3-cms-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Maispace",
            "role": "Developer"
        }
    ],
    "require": {
        "typo3/cms-backend": "^12.4 || ^13.0 || ^14.0",
        "typo3/cms-core": "^12.4 || ^13.0 || ^14.0",
        "typo3/cms-frontend": "^12.4 || ^13.0 || ^14.0",
        "typo3/cms-scheduler": "^12.4 || ^13.0 || ^14.0",
        "scssphp/scssphp": "^1.12",
        "matthiasmullie/minify": "^1.3"
    },
    "require-dev": {
        "a9f/fractor": "^1.0",
        "a9f/fractor-fluid": "^1.0",
        "a9f/fractor-htaccess": "^1.0",
        "a9f/fractor-typoscript": "^1.0",
        "a9f/fractor-xliff": "^1.0",
        "a9f/fractor-yaml": "^1.0",
        "a9f/typo3-fractor": "^1.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.6",
        "ssch/typo3-rector": "^3.14",
        "typo3/cms-extbase": "^14.1"
    },
    "autoload": {
        "psr-4": {
            "Maispace\\MaiAssets\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maispace\\MaiAssets\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "mai_assets"
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "lint:check": [
            "@check:editorconfig",
            "@check:phpcs",
            "@check:phpstan",
            "@check:typoscript",
            "@composer validate --strict --no-check-version --no-check-all --no-check-publish"
        ],
        "lint:fix": [
            "@fix:editorconfig",
            "@fix:phpcs",
            "@check:phpstan",
            "@check:typoscript"
        ],
        "check:editorconfig": "ec -unv -e vendor/ -e public/",
        "fix:editorconfig": "ec -unvf -e vendor/ -e public/",
        "check:phpcs": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer check --config .php-cs-fixer.php --ansi --verbose --diff",
        "fix:phpcs": "PHP_CS_FIXER_IGNORE_ENV=1 php-cs-fixer fix --config .php-cs-fixer.php --ansi",
        "check:phpstan": "phpstan analyse --no-progress",
        "check:phpstan:baseline": "phpstan analyse --no-progress --generate-baseline=phpstan-baseline.neon",
        "check:typoscript": "typoscript-lint --fail-on-warnings -c typoscript-lint.yml Configuration/",
        "test": "phpunit --configuration phpunit.xml.dist",
        "test:unit": "phpunit --configuration phpunit.xml.dist --testsuite Unit",
        "docs:viewhelpers": [
            "echo 'To generate ViewHelper documentation, install t3docs/fluid-documentation-generator:'",
            "echo 'composer require --dev t3docs/fluid-documentation-generator'",
            "echo 'Then run: vendor/bin/typo3 fluid:documentation:generate --extension=mai_assets --output=Documentation/ViewHelpers/'"
        ]
    },
    "config": {
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true,
            "a9f/fractor-extension-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    }
}
